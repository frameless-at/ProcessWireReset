# Defense in depth: deny direct HTTP access to internal state files.
# repair.php (the recovery endpoint) and the install/ profile directory
# are NOT blocked here — they are intended to be reachable.
<FilesMatch "^(recovery\.state\.php|\.pending-.*)$">
	Require all denied
	# Apache 2.2 fallback
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>
